{
  "productName": "Wobble",
  "version": "1.0.0",
  "identifier": "com.wobble.app",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Wobble", "url": "index.html", "width": 980, "height": 640, "minWidth": 820, "minHeight": 560 },
      { "label": "companion", "title": "Wobble Companion", "url": "index.html?c=1", "width": 200, "height": 230,
        "transparent": true, "decorations": false, "alwaysOnTop": true, "skipTaskbar": true,
        "resizable": false, "shadow": false, "visible": false }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"] }
}
