// ============================================================
//  Wobble — Sprite Loader
//  Injects wobble.svg into #wobble-stage and handles
//  cursor eye-tracking, petting gestures, and hover states.
// ============================================================

let stageEl = null;
let eyeLeft = null;
let eyeRight = null;
let highlightLeft = null;
let highlightRight = null;
let baseEyePos = { lx: 80, ly: 118, rx: 120, ry: 118 };

// ---- Init ------------------------------------------------------
export async function initSprite() {
  stageEl = document.getElementById("wobble-stage");
  if (!stageEl) {
    console.warn("[sprite] #wobble-stage not found");
    return;
  }

  try {
    const res = await fetch("assets/character/wobble.svg");
    const svgText = await res.text();
    stageEl.innerHTML = svgText;

    // Grab references
    eyeLeft        = stageEl.querySelector("#eye-left");
    eyeRight       = stageEl.querySelector("#eye-right");
    highlightLeft  = stageEl.querySelectorAll("#eyes circle")[0];
    highlightRight = stageEl.querySelectorAll("#eyes circle")[1];

    if (eyeLeft && eyeRight) {
      baseEyePos.lx = parseFloat(eyeLeft.getAttribute("cx"));
      baseEyePos.ly = parseFloat(eyeLeft.getAttribute("cy"));
      baseEyePos.rx = parseFloat(eyeRight.getAttribute("cx"));
      baseEyePos.ry = parseFloat(eyeRight.getAttribute("cy"));
    }

    // Attach cursor eye-tracking
    document.addEventListener("mousemove", onMouseMove);

    // Hover scale on Wobble
    stageEl.addEventListener("mouseenter", () => {
      stageEl.style.transform = "scale(1.04)";
    });
    stageEl.addEventListener("mouseleave", () => {
      stageEl.style.transform = "";
      resetEyes();
    });
  } catch (err) {
    console.error("[sprite] failed to load wobble.svg:", err);
  }
}

// ---- Cursor eye-tracking ---------------------------------------
function onMouseMove(e) {
  if (!eyeLeft || !eyeRight) return;

  const rect = stageEl.getBoundingClientRect();
  const cx = rect.left + rect.width  / 2;
  const cy = rect.top  + rect.height / 2;

  const dx = (e.clientX - cx) / rect.width;
  const dy = (e.clientY - cy) / rect.height;

  // Max eye shift in SVG units (subtle)
  const maxShift = 2.5;

  const shiftX = clamp(dx * maxShift, -maxShift, maxShift);
  const shiftY = clamp(dy * maxShift * 0.7, -1.6, 1.6);

  eyeLeft.setAttribute("cx",  baseEyePos.lx + shiftX);
  eyeLeft.setAttribute("cy",  baseEyePos.ly + shiftY);
  eyeRight.setAttribute("cx", baseEyePos.rx + shiftX);
  eyeRight.setAttribute("cy", baseEyePos.ry + shiftY);

  // Move highlights with the pupils
  if (highlightLeft && highlightRight) {
    highlightLeft.setAttribute("cx",  baseEyePos.lx + 2 + shiftX);
    highlightLeft.setAttribute("cy",  baseEyePos.ly - 3 + shiftY);
    highlightRight.setAttribute("cx", baseEyePos.rx + 2 + shiftX);
    highlightRight.setAttribute("cy", baseEyePos.ry - 3 + shiftY);
  }
}

function resetEyes() {
  if (!eyeLeft || !eyeRight) return;
  eyeLeft.setAttribute("cx",  baseEyePos.lx);
  eyeLeft.setAttribute("cy",  baseEyePos.ly);
  eyeRight.setAttribute("cx", baseEyePos.rx);
  eyeRight.setAttribute("cy", baseEyePos.ry);

  if (highlightLeft && highlightRight) {
    highlightLeft.setAttribute("cx",  baseEyePos.lx + 2);
    highlightLeft.setAttribute("cy",  baseEyePos.ly - 3);
    highlightRight.setAttribute("cx", baseEyePos.rx + 2);
    highlightRight.setAttribute("cy", baseEyePos.ry - 3);
  }
}

function clamp(v, lo, hi) {
  return Math.max(lo, Math.min(hi, v));
}
